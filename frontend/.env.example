# ==========================================
# CollabHub Frontend Environment Variables
# ==========================================

# Core Application Config
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Cloudinary (File Uploads) - ONLY public variables
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# WebRTC Signaling & ICE Servers
VITE_TURN_SERVER_URL=turn:global.turn.twilio.com:3478?transport=udp
VITE_TURN_SERVER_USERNAME=your_turn_username
VITE_TURN_SERVER_CREDENTIAL=your_turn_credential
